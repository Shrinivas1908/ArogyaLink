# Arogya Link — Environment Variables Template
# Copy to .env and fill values. NEVER commit the real .env to Git.

# ── Database (PostgreSQL via Docker Compose) ──────────────────────────────────
DATABASE_URL=postgresql+asyncpg://arogya:arogya_pass@localhost:5432/arogya_link

# ── Supabase Auth (required from Phase 1 onward) ─────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_JWT_AUD=authenticated
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated — kiosk (5173) and dashboard (5174)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# ── App ───────────────────────────────────────────────────────────────────────
APP_ENV=development
APP_VERSION=0.1.0

# ── AI / Integrations (required from Phase 8+ onward) ────────────────────────
GEMINI_API_KEY=
BHASHINI_API_KEY=
BHASHINI_USER_ID=
OPENAI_API_KEY=
ABDM_BASE_URL=https://sandbox.abdm.gov.in
ABDM_CLIENT_ID=
ABDM_CLIENT_SECRET=
ABDM_ENV=sandbox
PADDLEOCR_LANG=en
VOICE_TIMEOUT_SECS=10
